rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myUser() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isTeacher() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && myUser().data.role == 'teacher'; }
    function isPairMember(pairId) {
      return signedIn() && exists(/databases/$(database)/documents/pairs/$(pairId))
        && request.auth.uid in get(/databases/$(database)/documents/pairs/$(pairId)).data.members;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isTeacher());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (request.auth.uid == uid || isTeacher());
      allow delete: if isTeacher();
    }

    match /inviteCodes/{code} {
      allow get: if true;
      allow list, create, delete: if isTeacher();
      allow update: if signedIn();
    }

    match /pairs/{pairId} {
      allow read: if isPairMember(pairId) || isTeacher();
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow update: if isPairMember(pairId) || isTeacher();
      allow delete: if isTeacher();
    }

    match /pairEntries/{entryId} {
      allow read: if isPairMember(resource.data.pairId) || isTeacher();
      allow create: if signedIn() && isPairMember(request.resource.data.pairId);
      allow update: if signedIn() && isPairMember(resource.data.pairId);
      allow delete: if isTeacher();
    }

    match /memories/{memoryId} {
      allow read: if isPairMember(resource.data.pairId) || isTeacher();
      allow create: if signedIn() && isPairMember(request.resource.data.pairId);
      allow update: if signedIn() && isPairMember(resource.data.pairId);
      allow delete: if isTeacher();
    }

    match /notifications/{id} {
      allow read, update: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn();
      allow delete: if isTeacher();
    }

    match /reports/{id} {
      allow create: if signedIn();
      allow read, update, delete: if isTeacher();
    }
  }
}
