rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuth() { return request.auth != null; }
    function isOwner(uid) { return isAuth() && request.auth.uid == uid; }
    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Invite codes - anyone can read (needed for login)
    match /inviteCodes/{code} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Users - own data + admin can read all
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
    }
    
    // Diaries - owner + admin
    match /diaries/{diaryId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == request.resource.data.uid;
      allow update: if isAdmin() || (isAuth() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }
    
    // Homework - all students can read, only admin writes
    match /homework/{hwId} {
      allow read: if isAuth();
      allow create, delete: if isAdmin();
      allow update: if isAuth(); // Students submit their answers
    }
    
    // Announcements
    match /announcements/{id} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
  }
}
